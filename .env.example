# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, add these under the service's Environment tab instead.

# Connection string for a MongoDB database you control (for example a free Atlas cluster).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Optional: database to use inside that cluster (defaults to "demo").
MONGODB_DB_NAME=demo
